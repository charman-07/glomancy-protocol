{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:glomancy:protocol:approval.request:1.0.0",
  "title": "Approval Request",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "properties": {
        "schema_id": {
          "const": "urn:glomancy:protocol:approval.request:1.0.0"
        },
        "kind": {
          "const": "approval.request"
        },
        "payload": {
          "type": "object",
          "required": [
            "approval_id",
            "task_id",
            "risk_level",
            "action_summary",
            "consequences",
            "reversible",
            "expires_at"
          ],
          "properties": {
            "approval_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "task_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "risk_level": {
              "type": "string",
              "enum": [
                "R2",
                "R3",
                "R4"
              ]
            },
            "action_summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "consequences": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "reversible": {
              "type": "boolean"
            },
            "expires_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
