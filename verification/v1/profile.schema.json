{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:glomancy:conformance:task-verification-profile:1.0.0",
  "title": "Glomancy Task Verification Profile",
  "description": "Non-wire conformance policy describing structural verification requirements for one public task session.",
  "type": "object",
  "required": [
    "profile_version",
    "require_success",
    "require_context_snapshot_match",
    "require_read_back_verified",
    "required_evidence_types"
  ],
  "properties": {
    "profile_version": {
      "const": "1.0.0"
    },
    "require_success": {
      "type": "boolean"
    },
    "require_context_snapshot_match": {
      "type": "boolean"
    },
    "require_read_back_verified": {
      "type": "boolean"
    },
    "required_evidence_types": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:glomancy:protocol:evidence.record:1.0.0#/allOf/1/properties/payload/properties/evidence_type"
      }
    },
    "evidence_coverage": {
      "type": "object",
      "description": "Optional fail-closed structural coverage requirements over public evidence records and terminal evidence_ids references.",
      "properties": {
        "minimum_terminal_referenced_evidence_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "minimum_terminal_referenced_evidence_type_counts": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "enum": [
              "log",
              "screenshot",
              "asset-registry",
              "read-back",
              "build",
              "test",
              "diff",
              "rollback"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          }
        },
        "maximum_unreferenced_evidence_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
